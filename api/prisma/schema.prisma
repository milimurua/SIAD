// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Credentials {
  id String @id @default(uuid())
  email String @unique
  password String
  type String
  reference_id String
}

model Insurance {
  id_insurance String @id @default(uuid())
  cuit String @unique
  name_insurance String
  company_name String
  address String
  phone String?
  email String?
  branches Branch[]
  insureds Insured[]
  sinisters Sinister[]
}

model Branch {
  id_branch String @id @default(uuid())
  insurance_id String
  name_branch String
  address String
  phone String?
  email String?
  insurance Insurance @relation(fields: [insurance_id], references: [id_insurance])
  insureds Insured[]
  sinisters Sinister[]
}

model SafeProducer {
  id_producer String @id @default(uuid())
  tuition String
  country String
  emitter_entity String
  name_producer String
  dni String @unique
  phone String?
  email String?
  @@unique([country, emitter_entity, tuition])
}

model Insured {
  dni String @id
  name_insured String
  surname_insured String
  phone String?
  email String?
  address String
  branch_id String?
  insurance_id String?
  branch Branch? @relation(fields: [branch_id], references: [id_branch])
  insurance Insurance? @relation(fields: [insurance_id], references: [id_insurance])
  sinisters Sinister[] @relation("InsuredSinisters")
}

model Sinister {
  id_sinister String @id @default(uuid())
  insured_dni String?
  insurance_id String?
  branch_id String?
  date_sinister DateTime
  description_sinister String
  amount_sinister Decimal
  stay_sinister Boolean  @default(false)
  insured Insured? @relation("InsuredSinisters", fields: [insured_dni], references: [dni])
  insurance Insurance? @relation(fields: [insurance_id], references: [id_insurance])
  branch Branch? @relation(fields: [branch_id], references: [id_branch])
}
